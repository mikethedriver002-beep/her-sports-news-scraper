{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_id": "lpga_golf_winner_leaderboard.b.v1",
  "family": "LPGA / Golf",
  "variant": "B Leaderboard / Standings Update",
  "status": "review_only",
  "review_only": true,
  "canvas": { "w": 1080, "h": 1350, "orientation": "portrait_4x5" },
  "safe": { "t": 90, "r": 60, "b": 90, "l": 60 },
  "brand": { "asset": "assets/branding/HSD_Official_Current_Badge_DO_NOT_RECREATE.png", "fallback_asset": "assets/branding/official_hsd_watermark.png", "x": 48, "y": 42, "w": 80, "max_w": 96, "lockup_allowed_public": false },
  "zones": {
    "tournament_headline": [120, 120, 840, 160],
    "round_status": [120, 310, 840, 70],
    "leaderboard_rows": [80, 430, 920, 500],
    "short_context": [80, 970, 920, 110],
    "why_it_matters": [80, 1100, 920, 100],
    "question_cta": [80, 1220, 920, 70]
  },
  "round_status_examples": ["ROUND 1", "ROUND 2", "ROUND 3", "FINAL ROUND", "AFTER 18", "AFTER 36", "PROJECTED CUT"],
  "text_hierarchy": {
    "tournament_headline": { "min_px": 62, "case": "uppercase" },
    "round_status": { "min_px": 32, "case": "uppercase" },
    "leaderboard_row": { "min_px": 32 },
    "player_name": { "min_px": 30, "case": "uppercase" },
    "score_field": { "min_px": 32 },
    "short_context": { "min_px": 30, "max_lines": 3 },
    "question_cta": { "min_px": 34 }
  },
  "modules": {
    "leaderboard": { "mode": "readable_rows", "min_items": 3, "max_items": 5, "fields": ["position", "player_name", "score", "movement_or_note"] },
    "approved_event_logo_slot": { "mode": "optional", "label": "APPROVED EVENT LOGO SLOT", "required": false },
    "abstract_golf_texture": { "mode": "design_background", "required": false }
  },
  "usage_rules": {
    "leaderboard_card": true,
    "best_for": "Leaderboard updates, top five standings, final-round positioning, projected cut context, tournament status, or leaderboard-based storylines.",
    "round_status_must_be_editable": true,
    "no_tiny_score_tables": true
  },
  "rules": {
    "approved_assets_only": true,
    "approved_tournament_event_logo_slot_only": true,
    "abstract_golf_textures_allowed": true,
    "abstract_textures_do_not_replace_approved_imagery": true,
    "no_invented_scores": true,
    "no_invented_results": true,
    "no_invented_positions_or_rankings": true,
    "no_real_sounding_news_without_provided_details": true,
    "no_tiny_tables": true,
    "no_spreadsheet_look": true,
    "no_internal_variant_labels_on_public_exports": true,
    "text_contrast_min": 4.5,
    "large_text_contrast_min": 3.0,
    "non_text_contrast_min": 3.0,
    "renderer_mode": "review_only"
  },
  "when_to_use": "Use for LPGA leaderboard snapshots, standings updates, round status, final-round positioning, or projected cut context."
}
