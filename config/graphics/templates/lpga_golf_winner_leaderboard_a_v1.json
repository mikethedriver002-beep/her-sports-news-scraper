{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_id": "lpga_golf_winner_leaderboard.a.v1",
  "family": "LPGA / Golf",
  "variant": "A Winner / Champion Card",
  "status": "review_only",
  "review_only": true,
  "canvas": { "w": 1080, "h": 1350, "orientation": "portrait_4x5" },
  "safe": { "t": 90, "r": 60, "b": 90, "l": 60 },
  "brand": { "asset": "assets/branding/HSD_Official_Current_Badge_DO_NOT_RECREATE.png", "fallback_asset": "assets/branding/official_hsd_watermark.png", "x": 48, "y": 42, "w": 80, "max_w": 96, "lockup_allowed_public": false },
  "zones": {
    "tournament_name": [230, 100, 600, 60],
    "champion_headline": [80, 190, 920, 170],
    "player_name": [80, 390, 920, 170],
    "winner_champion_field": [80, 590, 450, 90],
    "result_score": [560, 590, 440, 90],
    "approved_player_or_trophy_texture_slot": [80, 720, 920, 250],
    "why_it_matters": [80, 1010, 920, 120],
    "question_cta": [80, 1170, 920, 90]
  },
  "text_hierarchy": {
    "tournament_name": { "min_px": 28, "case": "uppercase" },
    "champion_headline": { "min_px": 72, "case": "uppercase" },
    "player_name": { "min_px": 70, "case": "uppercase" },
    "winner_champion_field": { "min_px": 36, "examples": ["WINNER", "CHAMPION", "MAJOR WINNER"] },
    "result_score": { "min_px": 36, "examples": ["RESULT / SCORE", "FINAL SCORE", "TOURNAMENT RESULT"] },
    "why_it_matters": { "min_px": 32, "max_lines": 3 },
    "question_cta": { "min_px": 34 }
  },
  "modules": {
    "approved_player_image_slot": { "mode": "optional", "asset_type": "approved_player_image", "required": false },
    "approved_event_logo_slot": { "mode": "optional", "label": "APPROVED EVENT LOGO SLOT", "required": false },
    "abstract_golf_or_trophy_texture": { "mode": "design_background", "required": false },
    "question_cta": { "mode": "text", "required": false }
  },
  "usage_rules": {
    "winner_champion_card": true,
    "best_for": "LPGA winner, champion moment, major victory, trophy-focused result, or major final-round win.",
    "trophy_or_golf_visuals_are_abstract_unless_approved": true,
    "real_specific_result_requires_provided_details": true
  },
  "rules": {
    "approved_assets_only": true,
    "approved_player_images_only": true,
    "approved_tournament_event_logo_slot_only": true,
    "abstract_golf_textures_allowed": true,
    "abstract_trophy_textures_allowed": true,
    "abstract_textures_do_not_replace_approved_imagery": true,
    "no_invented_scores": true,
    "no_invented_results": true,
    "no_invented_records_quotes_injuries_or_rankings": true,
    "no_real_sounding_news_without_provided_details": true,
    "no_internal_variant_labels_on_public_exports": true,
    "text_contrast_min": 4.5,
    "large_text_contrast_min": 3.0,
    "non_text_contrast_min": 3.0,
    "renderer_mode": "review_only"
  },
  "dependentRequired": { "approved_player_image": ["approved_asset_id", "rights_status", "identity_verified"] },
  "when_to_use": "Use for an LPGA winner, champion moment, major victory, trophy-focused result, or major final-round win."
}
