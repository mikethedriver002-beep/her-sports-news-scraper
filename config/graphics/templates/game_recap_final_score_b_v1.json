{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_id": "game_recap_final_score.b.v1",
  "family": "Game Recap / Final Score",
  "variant": "B",
  "status": "review_only",
  "review_only": true,
  "canvas": { "w": 1080, "h": 1350, "orientation": "portrait_4x5" },
  "safe": { "t": 90, "r": 60, "b": 90, "l": 60 },
  "brand": { "asset": "assets/branding/HSD_Official_Current_Badge_DO_NOT_RECREATE.png", "fallback_asset": "assets/branding/official_hsd_watermark.png", "x": 48, "y": 42, "w": 80, "lockup_allowed_public": false },
  "zones": {
    "title": [60, 120, 960, 170],
    "context_bar": [60, 330, 960, 68],
    "primary_logo_slot": [60, 430, 180, 180],
    "primary_team": [260, 430, 430, 110],
    "primary_score": [60, 560, 620, 300],
    "secondary_logo_slot": [60, 880, 180, 180],
    "secondary_team": [260, 900, 300, 90],
    "secondary_score": [260, 980, 220, 120],
    "approved_player_photo_slot": [700, 430, 320, 520],
    "key_performer": [700, 970, 320, 120],
    "hook_takeaway": [60, 1130, 960, 160]
  },
  "text_hierarchy": {
    "title": { "min_px": 72, "case": "uppercase" },
    "primary_team": { "min_px": 60, "case": "uppercase" },
    "primary_score": { "min_px": 130, "case": "numeric" },
    "secondary_team": { "min_px": 38, "case": "uppercase" },
    "secondary_score": { "min_px": 62, "case": "numeric" },
    "key_performer": { "min_px": 30 },
    "hook_takeaway": { "min_px": 44, "optional": true }
  },
  "modules": {
    "primary_team_logo": { "asset_type": "approved_team_logo", "required": true },
    "secondary_team_logo": { "asset_type": "approved_team_logo", "required": true },
    "approved_player_photo": { "asset_type": "approved_player_photo", "required": true, "identity_verified_required": true, "rights_status_required": true },
    "key_performer": { "mode": "approved_photo_plus_text", "required": true },
    "hook_takeaway": { "mode": "text", "required": false, "brush_script_allowed": true, "brush_script_required": false }
  },
  "usage_rules": {
    "default_template": false,
    "player_photo_required": true,
    "player_photo_allowed": true,
    "use_only_when_approved_player_photo_exists": true,
    "if_no_approved_player_photo": "revert_to_game_recap_final_score.a.v1",
    "fallback_template_id": "game_recap_final_score.a.v1"
  },
  "rules": {
    "logos": "approved_only",
    "approved_player_photo_only": true,
    "no_fake_people": true,
    "no_demo_player_faces_in_public_exports": true,
    "no_fake_silhouettes_in_production": true,
    "no_fake_jerseys": true,
    "no_invented_scores": true,
    "no_invented_stats": true,
    "no_unverified_player_numbers_or_positions": true,
    "no_internal_variant_labels_on_public_exports": true,
    "use_primary_secondary_language": true,
    "generic_sports_logo_marks_internal_only": true,
    "winner_crown_optional_not_automatic": true,
    "brush_script_hook_optional_not_required": true,
    "text_contrast_min": 4.5,
    "large_text_contrast_min": 3.0,
    "non_text_contrast_min": 3.0,
    "renderer_mode": "review_only"
  },
  "dependentRequired": { "approved_player_photo": ["approved_asset_id", "rights_status", "identity_verified"] },
  "when_to_use": "Use when an approved player photo helps sell the final score story and there is a clear key performer angle."
}
