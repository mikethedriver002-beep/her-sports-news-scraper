{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_id": "tennis_wta_result.b.v1",
  "family": "Tennis / WTA",
  "variant": "B Tournament Story / Advancement",
  "status": "review_only",
  "review_only": true,
  "canvas": { "w": 1080, "h": 1350, "orientation": "portrait_4x5" },
  "safe": { "t": 90, "r": 60, "b": 90, "l": 60 },
  "brand": { "asset": "assets/branding/HSD_Official_Current_Badge_DO_NOT_RECREATE.png", "fallback_asset": "assets/branding/official_hsd_watermark.png", "x": 48, "y": 42, "w": 80, "max_w": 96, "lockup_allowed_public": false },
  "zones": {
    "story_family_label": [140, 110, 860, 60],
    "story_headline": [80, 210, 920, 250],
    "tournament_label": [80, 490, 920, 70],
    "round_bracket_context": [80, 590, 920, 110],
    "approved_image_or_logo_slot": [80, 740, 920, 260],
    "short_context": [80, 1030, 920, 110],
    "why_it_matters": [80, 1160, 920, 100]
  },
  "headline_examples": ["PLAYER NAME ADVANCES", "TOURNAMENT STORY HEADLINE", "TITLE RUN CONTINUES", "UPSET STORY HEADLINE", "MILESTONE STORY HEADLINE"],
  "text_hierarchy": {
    "story_family_label": { "min_px": 28, "case": "uppercase" },
    "story_headline": { "min_px": 58, "case": "uppercase" },
    "tournament_label": { "min_px": 32, "case": "uppercase" },
    "round_bracket_context": { "min_px": 32 },
    "short_context": { "min_px": 30, "max_lines": 3 },
    "why_it_matters": { "min_px": 32, "max_lines": 3 }
  },
  "modules": {
    "tour_event_logo_slot": { "mode": "optional", "label": "APPROVED TOUR / EVENT LOGO SLOT", "required": false },
    "approved_player_image_slot": { "mode": "optional", "asset_type": "approved_player_image", "required": false },
    "abstract_tennis_texture": { "mode": "design_background", "required": false },
    "why_it_matters": { "mode": "text", "required": false }
  },
  "usage_rules": {
    "tournament_story_card": true,
    "best_for": "Player advancement, title runs, upsets, seed stories, milestones, and major WTA tournament moments.",
    "placeholder_headline_should_be_editable": true,
    "real_specific_news_requires_provided_details": true
  },
  "rules": {
    "approved_assets_only": true,
    "approved_player_images_only": true,
    "approved_tour_or_event_logo_slot_only": true,
    "abstract_tennis_textures_allowed": true,
    "abstract_textures_do_not_replace_approved_imagery": true,
    "no_invented_results": true,
    "no_invented_scores": true,
    "no_invented_stats": true,
    "no_real_sounding_news_without_provided_details": true,
    "no_internal_variant_labels_on_public_exports": true,
    "text_contrast_min": 4.5,
    "large_text_contrast_min": 3.0,
    "non_text_contrast_min": 3.0,
    "renderer_mode": "review_only"
  },
  "dependentRequired": { "approved_player_image": ["approved_asset_id", "rights_status", "identity_verified"] },
  "when_to_use": "Use for WTA tournament stories where the story is advancement, a title run, an upset, a milestone, or broader bracket momentum."
}
