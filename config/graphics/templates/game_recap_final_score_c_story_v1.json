{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_id": "game_recap_final_score.c.story.v1",
  "family": "Game Recap / Final Score",
  "variant": "C Story",
  "status": "review_only",
  "review_only": true,
  "canvas": { "w": 1080, "h": 1920, "orientation": "vertical_9x16" },
  "safe": { "t": 120, "r": 60, "b": 140, "l": 60 },
  "brand": { "asset": "assets/branding/HSD_Official_Current_Badge_DO_NOT_RECREATE.png", "fallback_asset": "assets/branding/official_hsd_watermark.png", "x": 48, "y": 42, "w": 80, "lockup_allowed_public": false },
  "zones": {
    "title": [80, 160, 920, 180],
    "context_bar": [80, 380, 920, 70],
    "primary_logo_slot": [80, 500, 260, 260],
    "primary_team": [380, 520, 300, 120],
    "primary_score": [680, 470, 320, 360],
    "secondary_logo_slot": [80, 840, 260, 260],
    "secondary_team": [380, 870, 320, 120],
    "secondary_score": [700, 820, 260, 320],
    "key_performer_text_strip": [80, 1220, 920, 140],
    "hook_question": [80, 1390, 920, 200]
  },
  "text_hierarchy": {
    "title": { "min_px": 100, "case": "uppercase" },
    "primary_team": { "min_px": 54, "case": "uppercase" },
    "primary_score": { "min_px": 140, "case": "numeric" },
    "secondary_team": { "min_px": 44, "case": "uppercase" },
    "secondary_score": { "min_px": 110, "case": "numeric" },
    "key_performer": { "min_px": 34, "mode": "text_only" },
    "hook_question": { "min_px": 54, "optional": true }
  },
  "modules": {
    "primary_team_logo": { "asset_type": "approved_team_logo", "required": true },
    "secondary_team_logo": { "asset_type": "approved_team_logo", "required": true },
    "key_performer": { "mode": "text_only", "photo_allowed": false, "required": false },
    "hook_question": { "mode": "text", "required": false, "brush_script_allowed": true, "brush_script_required": false }
  },
  "usage_rules": {
    "story_template": true,
    "player_photo_required": false,
    "player_photo_allowed": false,
    "bottom_hook_must_clear_story_ui": true
  },
  "rules": {
    "logos": "approved_only",
    "no_fake_people": true,
    "no_demo_player_faces_in_public_exports": true,
    "no_fake_silhouettes_in_production": true,
    "no_fake_jerseys": true,
    "no_invented_scores": true,
    "no_invented_stats": true,
    "no_internal_variant_labels_on_public_exports": true,
    "use_primary_secondary_language": true,
    "generic_sports_logo_marks_internal_only": true,
    "winner_crown_optional_not_automatic": true,
    "brush_script_hook_optional_not_required": true,
    "text_contrast_min": 4.5,
    "large_text_contrast_min": 3.0,
    "non_text_contrast_min": 3.0,
    "renderer_mode": "review_only"
  },
  "when_to_use": "Fast vertical final-score post for Stories and Reels when speed and readability matter most."
}
