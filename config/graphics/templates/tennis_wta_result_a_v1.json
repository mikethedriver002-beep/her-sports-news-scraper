{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_id": "tennis_wta_result.a.v1",
  "family": "Tennis / WTA",
  "variant": "A Match Result / Preview",
  "status": "review_only",
  "review_only": true,
  "canvas": { "w": 1080, "h": 1350, "orientation": "portrait_4x5" },
  "safe": { "t": 90, "r": 60, "b": 90, "l": 60 },
  "brand": { "asset": "assets/branding/HSD_Official_Current_Badge_DO_NOT_RECREATE.png", "fallback_asset": "assets/branding/official_hsd_watermark.png", "x": 48, "y": 42, "w": 80, "max_w": 96, "lockup_allowed_public": false },
  "zones": {
    "tennis_headline": [120, 120, 840, 160],
    "player_primary": [80, 310, 920, 150],
    "opponent_or_matchup": [80, 490, 920, 90],
    "center_result_module": [80, 620, 920, 170],
    "tournament_round_label": [80, 820, 920, 70],
    "approved_image_or_texture_slot": [80, 920, 920, 190],
    "takeaway": [80, 1140, 920, 90],
    "question_cta": [80, 1240, 920, 70]
  },
  "modes": {
    "result_mode": {
      "fields": ["PLAYER NAME", "OPPONENT NAME", "RESULT_FIELD", "SET SCORELINE", "TOURNAMENT NAME", "ROUND NAME"],
      "center_module_text": "PLAYER NAME def. OPPONENT / SET SCORELINE",
      "result_label_editable": true
    },
    "preview_mode": {
      "fields": ["PLAYER NAME", "OPPONENT NAME", "ROUND", "TIME", "TOURNAMENT NAME"],
      "center_module_text": "PLAYER NAME vs OPPONENT / ROUND - TIME - TOURNAMENT",
      "result_label_allowed": false
    }
  },
  "text_hierarchy": {
    "tennis_headline": { "min_px": 58, "case": "uppercase" },
    "player_primary": { "min_px": 68, "case": "uppercase" },
    "opponent_or_matchup": { "min_px": 38, "case": "uppercase" },
    "scoreline_or_preview_context": { "min_px": 44 },
    "tournament_round_label": { "min_px": 30, "case": "uppercase" },
    "question_cta": { "min_px": 34 }
  },
  "modules": {
    "tour_event_logo_slot": { "mode": "optional", "label": "APPROVED TOUR / EVENT LOGO SLOT", "required": false },
    "approved_player_image_slot": { "mode": "optional", "asset_type": "approved_player_image", "required": false },
    "abstract_tennis_texture": { "mode": "design_background", "required": false },
    "question_cta": { "mode": "text", "required": false }
  },
  "usage_rules": {
    "match_result_or_preview_card": true,
    "result_and_preview_modes_must_not_mix": true,
    "result_field_editable_not_hardcoded": true,
    "approved_tour_event_logo_optional": true,
    "best_for": "WTA match results or previews where the main story is a player matchup, scoreline, or next match."
  },
  "rules": {
    "approved_assets_only": true,
    "approved_player_images_only": true,
    "approved_tour_or_event_logo_slot_only": true,
    "abstract_tennis_textures_allowed": true,
    "abstract_textures_do_not_replace_approved_imagery": true,
    "no_invented_results": true,
    "no_invented_scores": true,
    "no_invented_stats": true,
    "no_real_sounding_news_without_provided_details": true,
    "no_internal_variant_labels_on_public_exports": true,
    "text_contrast_min": 4.5,
    "large_text_contrast_min": 3.0,
    "non_text_contrast_min": 3.0,
    "renderer_mode": "review_only"
  },
  "dependentRequired": { "approved_player_image": ["approved_asset_id", "rights_status", "identity_verified"] },
  "when_to_use": "Use for a WTA match result or preview when the player matchup and scoreline/next-match context are the lead story."
}
