{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_id": "last_night_in_the_w.a.v1",
  "family": "Last Night in the W",
  "variant": "A",
  "status": "review_only",
  "review_only": true,
  "canvas": { "w": 1080, "h": 1350, "orientation": "portrait_4x5" },
  "safe": { "t": 90, "r": 60, "b": 90, "l": 60 },
  "brand": { "asset": "assets/branding/HSD_Official_Current_Badge_DO_NOT_RECREATE.png", "fallback_asset": "assets/branding/official_hsd_watermark.png", "x": 48, "y": 42, "w": 80, "max_w": 96, "lockup_allowed_public": false },
  "zones": {
    "franchise_title": [80, 130, 920, 130],
    "dynamic_subhead": [80, 280, 920, 60],
    "featured_result": [70, 380, 940, 270],
    "supporting_result_1": [70, 680, 940, 120],
    "supporting_result_2": [70, 820, 940, 120],
    "supporting_result_3": [70, 960, 940, 120],
    "takeaway_or_question": [70, 1130, 940, 120]
  },
  "text_hierarchy": {
    "franchise_title": { "min_px": 76, "case": "uppercase" },
    "dynamic_subhead": { "min_px": 32, "examples": ["[X] GAMES. ALL THE FINALS.", "[X] FINALS. ONE RECAP.", "TOP RESULTS. BIG MOMENTS."] },
    "team_name": { "min_px": 30, "case": "uppercase" },
    "score": { "min_px": 44, "case": "numeric" },
    "takeaway_or_question": { "min_px": 36 }
  },
  "modules": {
    "featured_result": { "mode": "result_card", "required": true, "optional_featured_tag_allowed": true },
    "supporting_results": { "mode": "result_rows", "min_items": 2, "max_items": 3, "asset_type": "approved_team_logo" },
    "takeaway_or_question": { "mode": "text", "required": false }
  },
  "usage_rules": {
    "default_template": true,
    "best_for": "3 to 4 game slate recap with one featured result and supporting finals underneath",
    "if_slate_has_five_or_more_games": "use last_night_in_the_w.b.story.v1 or last_night_in_the_w.c.carousel.v1",
    "subhead_must_be_dynamic": true
  },
  "rules": {
    "logos": "approved_only",
    "no_fake_people": true,
    "no_fake_silhouettes_in_production": true,
    "no_invented_scores": true,
    "no_invented_stats": true,
    "no_invented_records_or_standings": true,
    "no_tiny_tables": true,
    "no_spreadsheet_look": true,
    "no_internal_variant_labels_on_public_exports": true,
    "winner_emphasis_without_repeated_tags": true,
    "winner_tag_featured_result_only": true,
    "dynamic_slate_subhead_required": true,
    "score_placeholder_style": "00-00_or_SCORE_SLOT",
    "text_contrast_min": 4.5,
    "large_text_contrast_min": 3.0,
    "non_text_contrast_min": 3.0,
    "renderer_mode": "review_only"
  },
  "when_to_use": "Default Last Night in the W feed and Threads recap for 3 to 4 game slates."
}
