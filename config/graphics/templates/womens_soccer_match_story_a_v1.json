{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_id": "womens_soccer_match_story.a.v1",
  "family": "Women’s Soccer / NWSL / USWNT",
  "variant": "A Match Preview / Result",
  "status": "review_only",
  "review_only": true,
  "canvas": { "w": 1080, "h": 1350, "orientation": "portrait_4x5" },
  "safe": { "t": 90, "r": 60, "b": 90, "l": 60 },
  "brand": { "asset": "assets/branding/HSD_Official_Current_Badge_DO_NOT_RECREATE.png", "fallback_asset": "assets/branding/official_hsd_watermark.png", "x": 48, "y": 42, "w": 80, "max_w": 96, "lockup_allowed_public": false },
  "zones": {
    "soccer_headline": [120, 120, 840, 170],
    "league_competition_label": [120, 310, 840, 60],
    "left_team_logo_slot": [80, 420, 300, 260],
    "right_team_logo_slot": [700, 420, 300, 260],
    "center_match_module": [390, 430, 300, 250],
    "match_context": [80, 740, 920, 120],
    "why_it_matters": [80, 900, 920, 150],
    "question_cta": [80, 1110, 920, 110]
  },
  "modes": {
    "preview_mode": {
      "fields": ["TEAM ONE", "TEAM TWO", "DATE", "TIME", "COMPETITION"],
      "center_module_text": "TEAM ONE vs TEAM TWO",
      "status_label_allowed": false
    },
    "result_mode": {
      "fields": ["TEAM ONE", "TEAM ONE SCORE", "TEAM TWO", "TEAM TWO SCORE", "FINAL_OR_FULL_TIME", "COMPETITION"],
      "center_module_text": "TEAM ONE 00 / TEAM TWO 00",
      "status_label_allowed": true
    }
  },
  "text_hierarchy": {
    "soccer_headline": { "min_px": 60, "case": "uppercase" },
    "league_competition_label": { "min_px": 28, "case": "uppercase" },
    "team_name": { "min_px": 34, "case": "uppercase" },
    "score_or_matchup": { "min_px": 56 },
    "match_context": { "min_px": 30 },
    "question_cta": { "min_px": 36 }
  },
  "modules": {
    "team_or_country_logo_slots": { "asset_type": "approved_club_league_or_federation_logo", "required": true },
    "approved_player_image_slot": { "mode": "optional", "asset_type": "approved_player_image", "required": false },
    "question_cta": { "mode": "text", "required": false }
  },
  "usage_rules": {
    "match_preview_or_result_card": true,
    "preview_and_result_modes_must_not_mix": true,
    "do_not_show_full_time_on_preview": true,
    "best_for": "Women’s soccer match previews, result cards, club/country matchups, and quick competition-context posts."
  },
  "rules": {
    "approved_assets_only": true,
    "approved_club_league_or_federation_logos_only": true,
    "approved_player_images_only": true,
    "abstract_soccer_textures_allowed": true,
    "abstract_textures_do_not_replace_approved_imagery": true,
    "no_fake_kits": true,
    "no_fake_crests": true,
    "no_invented_scores": true,
    "no_invented_stats": true,
    "no_real_sounding_news_without_provided_details": true,
    "no_internal_variant_labels_on_public_exports": true,
    "text_contrast_min": 4.5,
    "large_text_contrast_min": 3.0,
    "non_text_contrast_min": 3.0,
    "renderer_mode": "review_only"
  },
  "dependentRequired": { "approved_player_image": ["approved_asset_id", "rights_status", "identity_verified"] },
  "when_to_use": "Use for women’s soccer match previews or result cards where the core story is a matchup or final."
}
