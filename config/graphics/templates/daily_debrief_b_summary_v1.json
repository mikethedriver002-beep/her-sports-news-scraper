{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_id": "daily_debrief.b.summary.v1",
  "family": "The Daily Debrief",
  "variant": "B Summary Card",
  "status": "review_only",
  "review_only": true,
  "canvas": { "w": 1080, "h": 1350, "orientation": "portrait_4x5" },
  "safe": { "t": 90, "r": 60, "b": 90, "l": 60 },
  "brand": { "asset": "assets/branding/HSD_Official_Current_Badge_DO_NOT_RECREATE.png", "fallback_asset": "assets/branding/official_hsd_watermark.png", "x": 48, "y": 42, "w": 80, "max_w": 96, "lockup_allowed_public": false },
  "zones": {
    "franchise_title": [150, 90, 860, 180],
    "editable_strapline": [150, 280, 820, 70],
    "hero_story": [70, 410, 940, 310],
    "supporting_story_1": [70, 760, 940, 180],
    "supporting_story_2": [70, 970, 940, 180],
    "bottom_question_or_cta": [70, 1190, 940, 90]
  },
  "text_hierarchy": {
    "franchise_title": { "min_px": 72, "case": "uppercase" },
    "editable_strapline": { "min_px": 32, "examples": ["3 STORIES. WHAT MATTERS TODAY.", "3 STORIES. ONE DAILY RESET.", "THE TOP STORIES IN WOMEN’S SPORTS."] },
    "hero_story_headline": { "min_px": 46, "case": "uppercase" },
    "supporting_story_headline": { "min_px": 34, "case": "uppercase" },
    "sport_league_label": { "min_px": 24, "case": "uppercase" },
    "bottom_question_or_cta": { "min_px": 34 }
  },
  "modules": {
    "story_blocks": { "min_items": 3, "max_items": 3, "structure": "one_hero_two_supporting" },
    "approved_image_or_logo_slot": { "mode": "approved_slot_or_abstract_texture", "required": false },
    "bottom_question_or_cta": { "mode": "text", "required": false }
  },
  "usage_rules": {
    "summary_card": true,
    "best_for": "A fast Feed or Threads graphic summarizing the day’s top three stories in one card",
    "broad_womens_sports_required": true,
    "story_max": 3,
    "strapline_must_be_editable": true
  },
  "rules": {
    "approved_assets_only": true,
    "approved_image_or_logo_slots_only": true,
    "abstract_editorial_textures_allowed": true,
    "no_invented_scores": true,
    "no_invented_stats": true,
    "no_invented_quotes_injuries_or_standings": true,
    "no_internal_variant_labels_on_public_exports": true,
    "public_mockups_clean_and_publish_ready": true,
    "keep_broad_womens_sports_identity": true,
    "no_tiny_text": true,
    "text_contrast_min": 4.5,
    "large_text_contrast_min": 3.0,
    "non_text_contrast_min": 3.0,
    "renderer_mode": "review_only"
  },
  "when_to_use": "Use when HSD needs one fast Feed or Threads graphic summarizing the day’s top three stories."
}
