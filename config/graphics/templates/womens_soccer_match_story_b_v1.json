{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_id": "womens_soccer_match_story.b.v1",
  "family": "Women’s Soccer / NWSL / USWNT",
  "variant": "B League / Roster / Callup Story",
  "status": "review_only",
  "review_only": true,
  "canvas": { "w": 1080, "h": 1350, "orientation": "portrait_4x5" },
  "safe": { "t": 90, "r": 60, "b": 90, "l": 60 },
  "brand": { "asset": "assets/branding/HSD_Official_Current_Badge_DO_NOT_RECREATE.png", "fallback_asset": "assets/branding/official_hsd_watermark.png", "x": 48, "y": 42, "w": 80, "max_w": 96, "lockup_allowed_public": false },
  "zones": {
    "story_family_label": [140, 110, 860, 60],
    "story_headline": [80, 210, 920, 250],
    "approved_image_or_logo_slot": [80, 500, 920, 300],
    "short_context": [80, 850, 920, 130],
    "why_it_matters": [80, 1020, 920, 140],
    "source_note_or_cta": [80, 1200, 920, 70]
  },
  "headline_examples": ["ROSTER STORY HEADLINE", "TEAM NAMES ROSTER", "CALLUP STORY HEADLINE", "PLAYER / TEAM STORY"],
  "text_hierarchy": {
    "story_family_label": { "min_px": 28, "case": "uppercase" },
    "story_headline": { "min_px": 58, "case": "uppercase" },
    "short_context": { "min_px": 30, "max_lines": 3 },
    "why_it_matters": { "min_px": 32, "max_lines": 3 },
    "source_note_or_cta": { "min_px": 24, "optional": true }
  },
  "modules": {
    "approved_image_or_logo_slot": { "mode": "approved_slot_or_abstract_soccer_texture", "required": false },
    "short_context": { "mode": "text", "required": true },
    "why_it_matters": { "mode": "text", "required": false },
    "source_note_or_cta": { "mode": "text", "required": false }
  },
  "usage_rules": {
    "editorial_story_card": true,
    "best_for": "Roster stories, callups, league-wide news, transfers, awards, milestones, and major women’s soccer moments.",
    "placeholder_headline_should_be_editable": true,
    "real_specific_news_requires_provided_details": true
  },
  "rules": {
    "approved_assets_only": true,
    "approved_club_league_or_federation_logos_only": true,
    "approved_player_images_only": true,
    "abstract_soccer_textures_allowed": true,
    "abstract_textures_do_not_replace_approved_imagery": true,
    "no_fake_kits": true,
    "no_fake_crests": true,
    "no_invented_stats": true,
    "no_real_sounding_news_without_provided_details": true,
    "no_internal_variant_labels_on_public_exports": true,
    "text_contrast_min": 4.5,
    "large_text_contrast_min": 3.0,
    "non_text_contrast_min": 3.0,
    "renderer_mode": "review_only"
  },
  "dependentRequired": { "approved_player_image": ["approved_asset_id", "rights_status", "identity_verified"] },
  "when_to_use": "Use for women’s soccer editorial/news cards when the story is a roster, callup, league, transfer, award, or culture moment rather than a single match."
}
