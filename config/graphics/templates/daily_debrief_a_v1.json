{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_id": "daily_debrief.a.v1",
  "family": "The Daily Debrief",
  "variant": "A Carousel System",
  "status": "review_only",
  "review_only": true,
  "canvas": { "w": 1080, "h": 1350, "orientation": "portrait_4x5" },
  "safe": { "t": 90, "r": 60, "b": 90, "l": 60 },
  "brand": { "asset": "assets/branding/HSD_Official_Current_Badge_DO_NOT_RECREATE.png", "fallback_asset": "assets/branding/official_hsd_watermark.png", "x": 48, "y": 42, "w": 80, "max_w": 96, "lockup_allowed_public": false },
  "slides": {
    "cover_slide": {
      "purpose": "Carousel opener for a 3-story broad women’s sports roundup",
      "zones": {
        "franchise_title": [120, 120, 880, 210],
        "editable_strapline": [120, 350, 840, 70],
        "story_count_cue": [80, 500, 920, 120],
        "broad_sports_identity": [80, 680, 920, 180],
        "swipe_cta": [80, 1080, 920, 90]
      }
    },
    "story_slide": {
      "purpose": "Reusable slide for one Daily Debrief story",
      "zones": {
        "story_number": [80, 130, 180, 90],
        "sport_league_label": [280, 140, 700, 60],
        "story_headline": [80, 260, 920, 220],
        "approved_image_or_logo_slot": [80, 520, 920, 310],
        "short_context": [80, 880, 920, 140],
        "why_it_matters": [80, 1060, 920, 130]
      }
    },
    "end_question_slide": {
      "purpose": "Discussion closer for the carousel",
      "zones": {
        "franchise_title": [100, 160, 880, 170],
        "question": [90, 450, 900, 260],
        "reply_cta": [90, 780, 900, 120],
        "recap_list": [90, 980, 900, 220]
      }
    }
  },
  "text_hierarchy": {
    "franchise_title": { "min_px": 72, "case": "uppercase" },
    "editable_strapline": { "min_px": 34, "examples": ["3 STORIES. WHAT MATTERS TODAY.", "3 STORIES. ONE DAILY RESET.", "THE TOP STORIES IN WOMEN’S SPORTS."] },
    "story_headline": { "min_px": 48, "case": "uppercase" },
    "short_context": { "min_px": 30, "max_lines": 3 },
    "why_it_matters": { "min_px": 32, "max_lines": 3 },
    "question": { "min_px": 48 }
  },
  "modules": {
    "story_count": { "min_items": 2, "max_items": 3, "default_items": 3 },
    "approved_image_or_logo_slot": { "mode": "approved_slot_or_abstract_texture", "required": false },
    "end_question": { "mode": "text", "required": true }
  },
  "usage_rules": {
    "carousel_system": true,
    "best_for": "A full Daily Debrief carousel with cover slide, story slides, and end-question slide",
    "broad_womens_sports_required": true,
    "wnba_only_not_allowed_by_default": true,
    "story_max": 3,
    "strapline_must_be_editable": true
  },
  "rules": {
    "approved_assets_only": true,
    "approved_image_or_logo_slots_only": true,
    "abstract_editorial_textures_allowed": true,
    "no_invented_scores": true,
    "no_invented_stats": true,
    "no_invented_quotes_injuries_or_standings": true,
    "no_internal_variant_labels_on_public_exports": true,
    "public_mockups_clean_and_publish_ready": true,
    "keep_broad_womens_sports_identity": true,
    "no_platform_ui_baked_into_story_graphics": true,
    "text_contrast_min": 4.5,
    "large_text_contrast_min": 3.0,
    "non_text_contrast_min": 3.0,
    "renderer_mode": "review_only"
  },
  "when_to_use": "Use when the Daily Debrief deserves a full carousel experience with three strong cross-sport stories."
}
