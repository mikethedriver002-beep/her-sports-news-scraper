{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_id": "game_recap_final_score.a.v1",
  "family": "Game Recap / Final Score",
  "variant": "A",
  "status": "review_only",
  "review_only": true,
  "canvas": { "w": 1080, "h": 1350, "orientation": "portrait_4x5" },
  "safe": { "t": 90, "r": 60, "b": 90, "l": 60 },
  "brand": { "asset": "assets/branding/HSD_Official_Current_Badge_DO_NOT_RECREATE.png", "fallback_asset": "assets/branding/official_hsd_watermark.png", "x": 48, "y": 42, "w": 80, "lockup_allowed_public": false },
  "zones": {
    "kicker": [80, 150, 280, 54],
    "primary_team_headline": [80, 230, 920, 150],
    "score": [80, 390, 920, 210],
    "secondary_team": [80, 610, 920, 90],
    "logo_cluster": [690, 330, 300, 360],
    "context_bar": [60, 760, 960, 90],
    "takeaway": [60, 900, 960, 210],
    "question": [60, 1160, 960, 100]
  },
  "text_hierarchy": {
    "primary_team": { "min_px": 72, "case": "uppercase" },
    "score": { "min_px": 140, "case": "numeric" },
    "secondary_team": { "min_px": 44, "case": "uppercase" },
    "takeaway": { "min_px": 38, "max_lines": 3 },
    "question": { "min_px": 36 }
  },
  "modules": {
    "primary_team_logo": { "asset_type": "approved_team_logo", "required": true },
    "secondary_team_logo": { "asset_type": "approved_team_logo", "required": true },
    "key_context": { "mode": "text", "allowed_modes": ["text", "approved_photo"], "fallback_modes": ["KEY PLAYER", "TURNING POINT", "WHY IT MATTERS"] }
  },
  "rules": { "logos": "approved_only", "no_fake_people": true, "no_fake_silhouettes_in_production": true, "no_invented_scores": true, "no_invented_stats": true, "text_contrast_min": 4.5, "large_text_contrast_min": 3.0, "non_text_contrast_min": 3.0, "renderer_mode": "review_only" },
  "dependentRequired": { "approved_photo": ["approved_asset_id", "rights_status", "identity_verified"] }
}
