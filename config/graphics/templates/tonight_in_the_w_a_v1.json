{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "template_id": "tonight_in_the_w.a.v1",
  "family": "Tonight in the W",
  "variant": "A",
  "status": "review_only",
  "review_only": true,
  "canvas": { "w": 1080, "h": 1350, "orientation": "portrait_4x5" },
  "safe": { "t": 90, "r": 60, "b": 90, "l": 60 },
  "brand": {
    "asset": "assets/branding/HSD_Official_Current_Badge_DO_NOT_RECREATE.png",
    "fallback_asset": "assets/branding/official_hsd_watermark.png",
    "x": 48,
    "y": 42,
    "w": 80,
    "lockup_allowed_public": false
  },
  "zones": {
    "kicker": [120, 58, 840, 56],
    "headline": [120, 116, 840, 250],
    "logo_left": [80, 420, 320, 250],
    "logo_right": [680, 420, 320, 250],
    "info_bar": [60, 700, 960, 84],
    "lower_module": [60, 820, 960, 170],
    "question": [60, 1030, 960, 180]
  },
  "text_hierarchy": {
    "kicker": { "text": "TONIGHT IN THE W", "min_px": 44, "case": "uppercase" },
    "headline": { "text": "MATCHUP", "min_px": 120, "case": "uppercase" },
    "meta": { "min_px": 30, "fields": ["date", "time", "tv_stream"] },
    "question": { "min_px": 44, "field": "debate_question" }
  },
  "modules": {
    "team_logo_left": { "asset_type": "approved_team_logo", "required": true },
    "team_logo_right": { "asset_type": "approved_team_logo", "required": true },
    "lower_module": { "mode": "text", "allowed_modes": ["text", "approved_photo"], "fallback_modes": ["KEY MATCHUP", "WATCH POINT", "WHY IT MATTERS"] }
  },
  "rules": {
    "logos": "approved_only",
    "no_fake_people": true,
    "no_fake_silhouettes_in_production": true,
    "no_fake_jerseys": true,
    "no_invented_stats": true,
    "text_contrast_min": 4.5,
    "large_text_contrast_min": 3.0,
    "non_text_contrast_min": 3.0,
    "renderer_mode": "review_only"
  },
  "dependentRequired": {
    "approved_photo": ["approved_asset_id", "rights_status", "identity_verified"]
  }
}
