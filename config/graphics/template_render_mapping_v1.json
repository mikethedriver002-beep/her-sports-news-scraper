{
  "version": "hsd-template-render-mapping-v1",
  "status": "review_only",
  "production_auto_render_allowed": false,
  "registry_path": "config/graphics/template_registry_v1.json",
  "policy": {
    "renderer_is_compiler_not_designer": true,
    "use_approved_templates_only": true,
    "review_only_outputs": true,
    "human_review_required_before_publish": true
  },
  "event_mappings": [
    {
      "name": "single_game_final_feed_threads",
      "sport": "basketball",
      "league": "WNBA",
      "row_kind": "result",
      "platforms": ["ig_feed", "threads"],
      "template_id": "game_recap_final_score.a.v1",
      "mode": "logo_first_final_score"
    },
    {
      "name": "single_game_final_story",
      "sport": "basketball",
      "league": "WNBA",
      "row_kind": "result",
      "platforms": ["stories"],
      "template_id": "game_recap_final_score.c.story.v1",
      "mode": "story_quick_final"
    },
    {
      "name": "wnba_preview_feed_threads",
      "sport": "basketball",
      "league": "WNBA",
      "row_kind": "preview",
      "platforms": ["ig_feed", "threads"],
      "template_id": "tonight_in_the_w.a.v1",
      "mode": "matchup_preview"
    }
  ],
  "batch_mappings": [
    {
      "name": "last_night_in_the_w_feed_threads",
      "source": "today_final_results.csv",
      "family": "Last Night in the W",
      "platforms": ["ig_feed", "threads"],
      "template_id": "last_night_in_the_w.a.v1",
      "mode": "featured_result_plus_supporting_finals",
      "min_final_rows": 2,
      "max_recommended_final_rows": 4
    },
    {
      "name": "last_night_in_the_w_story",
      "source": "today_final_results.csv",
      "family": "Last Night in the W",
      "platforms": ["stories"],
      "template_id": "last_night_in_the_w.b.story.v1",
      "mode": "rolling_story_recap",
      "min_final_rows": 2,
      "max_recommended_final_rows": 5
    },
    {
      "name": "last_night_in_the_w_carousel",
      "source": "today_final_results.csv",
      "family": "Last Night in the W",
      "platforms": ["carousel"],
      "template_id": "last_night_in_the_w.c.carousel.v1",
      "mode": "carousel_cover_recap_package",
      "min_final_rows": 2,
      "max_recommended_final_rows": 6
    }
  ],
  "future_mappings": [
    { "family": "Daily Debrief", "status": "needs_story_selection_contract", "template_ids": ["daily_debrief.a.v1", "daily_debrief.b.summary.v1", "daily_debrief.c.story.v1"] },
    { "family": "Women’s Soccer / NWSL / USWNT", "status": "needs_multisport_contract", "template_ids": ["womens_soccer_match_story.a.v1", "womens_soccer_match_story.b.v1", "womens_soccer_match_story.c.story.v1"] },
    { "family": "Tennis / WTA", "status": "needs_multisport_contract", "template_ids": ["tennis_wta_result.a.v1", "tennis_wta_result.b.v1", "tennis_wta_result.c.story.v1"] },
    { "family": "LPGA / Golf", "status": "needs_multisport_contract", "template_ids": ["lpga_golf_winner_leaderboard.a.v1", "lpga_golf_winner_leaderboard.b.v1", "lpga_golf_winner_leaderboard.c.story.v1"] }
  ]
}
