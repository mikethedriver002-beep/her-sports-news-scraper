{
  "$id": "https://hersportsdaily.local/schemas/hsd-template-spec-v4.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "anyOf": [
    {"required": ["zones"]},
    {"required": ["cover_slide", "package_slides"]}
  ],
  "properties": {
    "badge": {
      "additionalProperties": true,
      "properties": {
        "asset": {"const": "official_hsd_badge_reference.png"},
        "h": {"minimum": 1, "type": "integer"},
        "rules": {"items": {"type": "string"}, "minItems": 1, "type": "array"},
        "w": {"minimum": 1, "type": "integer"},
        "w_max": {"minimum": 1, "type": "integer"},
        "w_min": {"minimum": 1, "type": "integer"},
        "x": {"minimum": 0, "type": "integer"},
        "y": {"minimum": 0, "type": "integer"}
      },
      "required": ["asset", "x", "y", "rules"],
      "type": "object"
    },
    "canvas": {
      "additionalProperties": false,
      "properties": {
        "height": {"minimum": 1, "type": "integer"},
        "width": {"minimum": 1, "type": "integer"}
      },
      "required": ["width", "height"],
      "type": "object"
    },
    "cover_slide": {"type": "object"},
    "family": {"minLength": 1, "type": "string"},
    "format": {"enum": ["ig_feed_threads", "ig_story_reels", "ig_carousel"]},
    "package_slides": {"type": "object"},
    "renderer_notes": {"items": {"type": "string"}, "type": "array"},
    "safe_zones": {
      "additionalProperties": false,
      "properties": {
        "bottom": {"minimum": 0, "type": "integer"},
        "left": {"minimum": 0, "type": "integer"},
        "right": {"minimum": 0, "type": "integer"},
        "top": {"minimum": 0, "type": "integer"}
      },
      "required": ["top", "right", "bottom", "left"],
      "type": "object"
    },
    "template_id": {"minLength": 1, "type": "string"},
    "variant": {"minLength": 1, "type": "string"},
    "when_to_use": {"type": "string"},
    "zones": {"type": "object"}
  },
  "required": ["template_id", "family", "variant", "format", "canvas", "safe_zones", "badge"],
  "title": "HSD Canonical Template Specification v4",
  "type": "object"
}
