{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://her-sports-daily.local/conductor/directive.schema.json",
  "title": "HSD Conductor Directive Snapshot",
  "description": "Review-only, immutable directive snapshot for one HSD workflow run or branch lane. This schema is a brake foundation only; it is not a conductor daemon contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "directive_id",
    "directive_path",
    "created_at_utc",
    "target_branch",
    "base_ref",
    "lane",
    "branch_collision_policy",
    "guardrails",
    "operator_notes"
  ],
  "properties": {
    "schema_version": {
      "const": "hsd-conductor-directive-v1"
    },
    "directive_id": {
      "type": "string",
      "pattern": "^hsd-[a-z0-9][a-z0-9-]*-[0-9]{8}T[0-9]{6}Z$"
    },
    "directive_path": {
      "type": "string",
      "description": "Repo-relative immutable snapshot path. Shared mutable files such as conductor/directive.json are intentionally forbidden.",
      "pattern": "^conductor/directives/(runs/[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]*|branches/[a-z0-9][a-z0-9._/-]*/[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]*)\\.json$",
      "not": {
        "enum": [
          "conductor/directive.json",
          "conductor/runtime/directive.json",
          "directive.json"
        ]
      }
    },
    "created_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "target_branch": {
      "type": "string",
      "minLength": 1
    },
    "base_ref": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scope",
        "out_of_scope"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "branch_collision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directive_storage",
        "shared_mutable_directive_path_allowed",
        "required_git_start",
        "branch_namespace",
        "runtime_state"
      ],
      "properties": {
        "directive_storage": {
          "enum": [
            "immutable_run_scoped_snapshot",
            "branch_scoped_snapshot"
          ]
        },
        "shared_mutable_directive_path_allowed": {
          "const": false
        },
        "required_git_start": {
          "enum": [
            "current_origin_main"
          ]
        },
        "branch_namespace": {
          "type": "string",
          "pattern": "^codex/[a-z0-9][a-z0-9._-]*$"
        },
        "runtime_state": {
          "const": "conductor/runtime_only_not_committed"
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_only",
        "paid_apis",
        "source_fetching",
        "automatic_downloads",
        "auto_approval",
        "approval_state_change",
        "headshot_writes",
        "approved_marker_writes",
        "publish_ready",
        "publishing"
      ],
      "properties": {
        "review_only": {
          "const": true
        },
        "paid_apis": {
          "const": false
        },
        "source_fetching": {
          "const": false
        },
        "automatic_downloads": {
          "const": false
        },
        "auto_approval": {
          "const": false
        },
        "approval_state_change": {
          "const": false
        },
        "headshot_writes": {
          "const": false
        },
        "approved_marker_writes": {
          "const": false
        },
        "publish_ready": {
          "const": false
        },
        "publishing": {
          "const": false
        }
      }
    },
    "operator_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
